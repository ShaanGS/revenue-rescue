# Copy this file to .env locally. Never commit .env.
# Use only sandbox/test workspaces and test customer data for the demo.

# GitHub: creates the engineering recovery issue.
GITHUB_TOKEN=
GITHUB_REPOSITORY=ShaanGS/revenue-rescue

# Slack: posts the evidence-backed internal escalation.
SLACK_BOT_TOKEN=
SLACK_RECOVERY_CHANNEL=

# Google OAuth access token with Gmail send + Calendar write scopes.
GOOGLE_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary

# HubSpot private app token and test company record ID.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_COMPANY_ID=
